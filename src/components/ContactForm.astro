---
---
<div class="premium-contact-form">
    <div class="form-header text-center">
        <h3 class="title">Detailed Valuation Request</h3>
        <p class="subtitle">Get a professional valuation for your vehicle within 24 hours.</p>
    </div>
    <form class="form__content" method="post" action="#" id="contact-form">
        <div class="form-section">
            <h6 class="section-tag">Angaben zum Fahrzeug</h6>
            <div class="row">
                <div class="col-md-6">
                    <div class="form__control">
                        <label for="make_type">Marke & Typ *</label>
                        <input type="text" id="make_type" class="input-form" name="make_type"
                            placeholder="e.g. BMW M4" required>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form__control">
                        <label for="registration">1. Inverkehrsetzung *</label>
                        <input type="text" id="registration" class="input-form" name="registration"
                            placeholder="MM.YYYY" required>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form__control">
                        <label for="mileage">Kilometerstand *</label>
                        <input type="text" id="mileage" class="input-form" name="mileage"
                            placeholder="e.g. 45'000" required>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form__control">
                        <label for="price">Preisvorstellung</label>
                        <input type="text" id="price" class="input-form" name="price"
                            placeholder="CHF">
                    </div>
                </div>
            </div>
        </div>

        <div class="form-section mt--30">
            <h6 class="section-tag">Angaben zum Fahrzeughalter</h6>
            <div class="row">
                <div class="col-md-6">
                    <div class="form__control">
                        <label for="last_name">Name *</label>
                        <input type="text" id="last_name" class="input-form" name="last_name" placeholder="Doe"
                            required>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form__control">
                        <label for="first_name">Vorname *</label>
                        <input type="text" id="first_name" class="input-form" name="first_name"
                            placeholder="John" required>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form__control">
                        <label for="phone">Telefon *</label>
                        <input type="text" id="phone_form" class="input-form" name="phone" placeholder="+41 79 000 00 00"
                            required>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form__control">
                        <label for="email">E-Mail *</label>
                        <input type="email" id="email_form" class="input-form" name="email" placeholder="john@example.com"
                            required>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form__control">
                        <label for="message">Bemerkungen</label>
                        <textarea name="message" id="message_form" cols="30" rows="4"
                            placeholder="Describe your vehicle's condition, equipment, etc."></textarea>
                    </div>
                </div>
            </div>
        </div>
        <div class="form-footer text-center mt--30">
            <button type="submit" class="premium-submit-btn">
                <span>Submit Valuation Request</span>
                <i class="rt-icon-arrow-right"></i>
            </button>
            <p class="privacy-note">Your data is handled according to our <a href="/privacy-policy">Privacy Policy</a>.</p>
        </div>
    </form>
    <div id="form-messages"></div>
</div>

<style>
    .premium-contact-form {
        background: #ffffff;
        padding: 50px;
        border-radius: 20px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.08);
        border: 1px solid rgba(0, 0, 0, 0.05);
        max-width: 900px;
        margin: 0 auto;
    }

    .form-header {
        margin-bottom: 40px;
    }

    .form-header .title {
        font-size: 32px;
        font-weight: 700;
        color: #05539a;
        margin-bottom: 10px;
    }

    .form-header .subtitle {
        color: #666;
        font-size: 16px;
    }

    .section-tag {
        font-size: 14px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #05539a;
        margin-bottom: 25px;
        display: block;
        border-bottom: 2px solid #f0f0f0;
        padding-bottom: 10px;
    }

    .form__control {
        margin-bottom: 20px;
    }

    .form__control label {
        display: block;
        font-size: 14px;
        font-weight: 600;
        color: #333;
        margin-bottom: 8px;
    }

    .input-form, textarea {
        width: 100%;
        padding: 12px 20px;
        border: 1px solid #e0e0e0;
        border-radius: 10px;
        background: #fafafa;
        font-size: 15px;
        transition: all 0.3s ease;
    }

    .input-form:focus, textarea:focus {
        border-color: #05539a;
        background: #fff;
        box-shadow: 0 0 0 4px rgba(5, 83, 154, 0.1);
        outline: none;
    }

    .premium-submit-btn {
        background: linear-gradient(135deg, #05539a 0%, #033a6b 100%);
        color: white;
        padding: 18px 45px;
        border-radius: 50px;
        border: none;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 12px;
        box-shadow: 0 10px 20px rgba(5, 83, 154, 0.2);
    }

    .premium-submit-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 30px rgba(5, 83, 154, 0.3);
        background: linear-gradient(135deg, #0666bd 0%, #05539a 100%);
    }

    .premium-submit-btn i {
        font-size: 14px;
    }

    .privacy-note {
        font-size: 12px;
        color: #999;
        margin-top: 15px;
    }

    .privacy-note a {
        color: #05539a;
        text-decoration: underline;
    }

    @media (max-width: 768px) {
        .premium-contact-form {
            padding: 30px 20px;
        }
        
        .form-header .title {
            font-size: 24px;
        }
    }
</style>
