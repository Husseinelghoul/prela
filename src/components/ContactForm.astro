---
import type { Lang } from "../i18n/ui";

interface Props {
    lang?: Lang;
}

const { lang = "de" } = Astro.props;
const isFr = lang === "fr";

const c = isFr
    ? {
          title: "Demander une estimation",
          subtitle: "Recevez une estimation gratuite de votre voiture sous 24 heures.",
          next: "https://prela-automobile.ch/fr/merci",
          vehicleInfo: "Informations sur le véhicule",
          makeModel: "Marque et modèle *",
          registration: "Première mise en circulation *",
          mileage: "Kilométrage *",
          price: "Prix souhaité",
          contactData: "Coordonnées",
          lastName: "Nom *",
          firstName: "Prénom *",
          phone: "Téléphone *",
          email: "E-mail",
          remarks: "Remarques",
          remarksPlaceholder: "Décrivez l'état, les équipements, les dommages éventuels, etc.",
          submit: "Demander l'estimation",
          privacyBefore: "Vos données sont traitées conformément à notre ",
          privacyLink: "politique de confidentialité",
          privacyAfter: ".",
          makeModelPh: "p. ex. BMW M4",
          registrationPh: "MM.AAAA",
          mileagePh: "p. ex. 45'000 km",
      }
    : {
          title: "Fahrzeugbewertung anfragen",
          subtitle: "Erhalten Sie eine kostenlose Bewertung Ihres Autos innerhalb von 24 Stunden.",
          next: "https://prela-automobile.ch/danke",
          vehicleInfo: "Fahrzeuginformationen",
          makeModel: "Marke & Modell *",
          registration: "Erstzulassung *",
          mileage: "Kilometerstand *",
          price: "Gewünschter Preis",
          contactData: "Kontaktdaten",
          lastName: "Nachname *",
          firstName: "Vorname *",
          phone: "Telefon *",
          email: "E-Mail",
          remarks: "Bemerkungen",
          remarksPlaceholder: "Beschreiben Sie den Zustand, Ausstattung, Unfallschäden etc.",
          submit: "Bewertung anfordern",
          privacyBefore: "Ihre Daten werden gemäss unserer ",
          privacyLink: "Datenschutzerklärung",
          privacyAfter: " behandelt.",
          makeModelPh: "z.B. BMW M4",
          registrationPh: "MM.JJJJ",
          mileagePh: "z.B. 45'000 km",
      };

// Legal pages exist in German only (per project scope) — link there from both locales.
const privacyHref = "/datenschutz";
---

<div class="premium-contact-form">
    <div class="form-header text-center">
        <h3 class="title">{c.title}</h3>
        <p class="subtitle">
            {c.subtitle}
        </p>
    </div>
    <form
        class="form__content"
        method="POST"
        action="https://formspree.io/f/maqdyeoz"
        id="valuation-form"
    >
        <input
            type="hidden"
            name="_next"
            value={c.next}
        />
        <div class="form-section">
            <h6 class="section-tag">{c.vehicleInfo}</h6>
            <div class="row">
                <div class="col-md-6">
                    <div class="form__control">
                        <label for="make_model">{c.makeModel}</label>
                        <input
                            type="text"
                            id="make_model"
                            class="input-form"
                            name="make_model"
                            placeholder={c.makeModelPh}
                            required
                        />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form__control">
                        <label for="registration">{c.registration}</label>
                        <input
                            type="text"
                            id="registration"
                            class="input-form"
                            name="registration"
                            placeholder={c.registrationPh}
                            required
                        />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form__control">
                        <label for="mileage">{c.mileage}</label>
                        <input
                            type="text"
                            id="mileage"
                            class="input-form"
                            name="mileage"
                            placeholder={c.mileagePh}
                            required
                        />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form__control">
                        <label for="price">{c.price}</label>
                        <input
                            type="text"
                            id="price"
                            class="input-form"
                            name="price"
                            placeholder="CHF"
                        />
                    </div>
                </div>
            </div>
        </div>

        <div class="form-section mt--30">
            <h6 class="section-tag">{c.contactData}</h6>
            <div class="row">
                <div class="col-md-6">
                    <div class="form__control">
                        <label for="last_name">{c.lastName}</label>
                        <input
                            type="text"
                            id="last_name"
                            class="input-form"
                            name="last_name"
                            placeholder="Muster"
                            required
                        />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form__control">
                        <label for="first_name">{c.firstName}</label>
                        <input
                            type="text"
                            id="first_name"
                            class="input-form"
                            name="first_name"
                            placeholder="Max"
                            required
                        />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form__control">
                        <label for="phone_form">{c.phone}</label>
                        <input
                            type="text"
                            id="phone_form"
                            class="input-form"
                            name="phone"
                            placeholder="+41 79 000 00 00"
                            required
                        />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form__control">
                        <label for="email_form">{c.email}</label>
                        <input
                            type="email"
                            id="email_form"
                            class="input-form"
                            name="email"
                            placeholder="max@beispiel.ch"
                        />
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form__control">
                        <label for="message_form">{c.remarks}</label>
                        <textarea
                            name="message"
                            id="message_form"
                            cols="30"
                            rows="4"
                            placeholder={c.remarksPlaceholder}
                        ></textarea>
                    </div>
                </div>
            </div>
        </div>
        <div class="form-footer mt--30">
            <button type="submit" class="premium-submit-btn">
                <span>{c.submit}</span>
                <i class="fa-light fa-arrow-right"></i>
            </button>
            <p class="privacy-note">
                {c.privacyBefore}<a href={privacyHref}>{c.privacyLink}</a>{c.privacyAfter}
            </p>
        </div>
    </form>
    <div id="form-messages"></div>
</div>

<style>
    .premium-contact-form {
        background: #ffffff;
        padding: 50px;
        border-radius: 20px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.08);
        border: 1px solid rgba(0, 0, 0, 0.05);
        max-width: 900px;
        margin: 0 auto;
    }

    .form-header {
        margin-bottom: 40px;
    }

    .form-header .title {
        font-size: 32px;
        font-weight: 700;
        color: #05539a;
        margin-bottom: 10px;
    }

    .form-header .subtitle {
        color: #666;
        font-size: 16px;
    }

    .section-tag {
        font-size: 14px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #05539a;
        margin-bottom: 25px;
        display: block;
        border-bottom: 2px solid #f0f0f0;
        padding-bottom: 10px;
    }

    .form__control {
        margin-bottom: 20px;
    }

    .form__control label {
        display: block;
        font-size: 14px;
        font-weight: 600;
        color: #333;
        margin-bottom: 8px;
    }

    .input-form,
    textarea {
        width: 100%;
        padding: 12px 20px;
        border: 1px solid #e0e0e0;
        border-radius: 10px;
        background: #fafafa;
        font-size: 15px;
        transition: all 0.3s ease;
    }

    .input-form:focus,
    textarea:focus {
        border-color: #05539a;
        background: #fff;
        box-shadow: 0 0 0 4px rgba(5, 83, 154, 0.1);
        outline: none;
    }

    .form-footer {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .premium-submit-btn {
        background: linear-gradient(135deg, #05539a 0%, #033a6b 100%);
        color: white;
        padding: 18px 45px;
        border-radius: 50px;
        border: none;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        box-shadow: 0 10px 20px rgba(5, 83, 154, 0.2);
        width: 100%;
        max-width: 400px;
    }

    .premium-submit-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 30px rgba(5, 83, 154, 0.3);
        background: linear-gradient(135deg, #0666bd 0%, #05539a 100%);
    }

    .premium-submit-btn i {
        font-size: 14px;
    }

    .privacy-note {
        font-size: 12px;
        color: #999;
        margin-top: 15px;
    }

    .privacy-note a {
        color: #05539a;
        text-decoration: underline;
    }

    @media (max-width: 768px) {
        .premium-contact-form {
            padding: 30px 20px;
        }

        .form-header .title {
            font-size: 24px;
        }
    }
</style>
