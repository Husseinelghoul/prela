---
interface Props {
  title: string;
  current: string;
  className?: string;
}

const { title, current, className = "" } = Astro.props;
---

<!-- rts breadcrumb area start -->
<div class={`rts-breadcrumb-area ${className} jarallax`}>
    <div class="container">
        <div class="breadcrumb-area-wrapper">
            <h1 class="title">{title}</h1>
            <div class="nav-bread-crumb">
                <a href="/">Home</a>
                <a href="#" class="current">{current}</a>
            </div>
        </div>
    </div>
</div>
<!-- rts breadcrumb area end -->
