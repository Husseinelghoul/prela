---

---

<!-- header area start -->
<header class="header-one header--sticky">
    <div class="container-fluid px-5">
        <div class="row">
            <div class="col-lg-12">
                <div class="header-wrapper-1">
                    <div class="logo-area-start">
                        <a href="/" class="logo">
                            <img
                                src="/images/logo/prela_logo.webp"
                                alt="Prela Automobile AG Logo – Autohändler Luzern"
                                style="max-height: 120px; margin-left: -15px;"
                            />
                        </a>
                    </div>
                    <div class="header-right d-block">
                        <div class="top">
                            <div class="left d-flex align-items-center">
                                <div class="map-area">
                                    <i class="fa-light fa-phone-flip" aria-hidden="true"></i>
                                    <a href="callto:+41793088000"
                                        >+41 79 308 80 00</a
                                    >
                                </div>
                                <div class="map-area">
                                    <i class="fa-light fa-envelope" aria-hidden="true"></i>
                                    <a href="mailto:info@prela-automobile.ch"
                                        >info@prela-automobile.ch</a
                                    >
                                </div>
                                <div class="map-area">
                                    <i class="fa-light fa-location-dot" aria-hidden="true"></i>
                                    <a
                                        href="https://www.google.com/maps/search/Allmendstrasse+10,+6210+Luzern"
                                        target="_blank"
                                        >Allmendstrasse 10, 6210 Luzern</a
                                    >
                                </div>
                            </div>
                        </div>
                        <div
                            class="bottom d-flex align-items-center justify-content-between"
                        >
                            <div class="nav-area">
                                <ul class="">
                                    <li class="main-nav">
                                        <a
                                            class="main-menu"
                                            href="/"
                                            data-astro-prefetch>Startseite</a
                                        >
                                    </li>
                                    <li class="main-nav">
                                        <a
                                            class="main-menu"
                                            href="/ueber-uns"
                                            data-astro-prefetch>Über Uns</a
                                        >
                                    </li>
                                    <li class="main-nav has-dropdown">
                                        <a
                                            class="main-menu"
                                            href="javascript:void(0)"
                                            >Tipps & Ratgeber</a
                                        >
                                        <ul class="submenu parent-nav">
                                            <li>
                                                <a
                                                    href="/tipps/auto-verkaufen"
                                                    data-astro-prefetch
                                                    >Auto verkaufen</a
                                                >
                                            </li>
                                            <li>
                                                <a
                                                    href="/tipps/auto-kaufen"
                                                    data-astro-prefetch
                                                    >Auto kaufen</a
                                                >
                                            </li>
                                            <li>
                                                <a
                                                    href="/tipps/auto-exportieren"
                                                    data-astro-prefetch
                                                    >Auto exportieren</a
                                                >
                                            </li>
                                        </ul>
                                    </li>
                                    <li class="main-nav">
                                        <a
                                            class="main-menu"
                                            href="/kontakt"
                                            data-astro-prefetch>Kontakt</a
                                        >
                                    </li>
                                </ul>
                            </div>
                            <div class="bottom-right">
                                <div class="button-area">
                                    <a
                                        href="/bewertung"
                                        class="rts-btn btn-primary radius-big icon"
                                    >
                                        Gratis Bewertung
                                    </a>
                                </div>
                                <div
                                    class="menu-btn"
                                    id="menu-btn"
                                    role="button"
                                    tabindex="0"
                                    title="Menü öffnen"
                                    aria-label="Menü öffnen"
                                >
                                    <svg
                                        width="55"
                                        height="55"
                                        viewBox="0 0 55 55"
                                        fill="none"
                                        xmlns="http://www.w3.org/2000/svg"
                                    >
                                        <rect
                                            width="55"
                                            height="55"
                                            rx="15"
                                            fill="#05539a"></rect>
                                        <rect
                                            x="18"
                                            y="33"
                                            width="10"
                                            height="2"
                                            fill="#ffffff"></rect>
                                        <rect
                                            x="18"
                                            y="26"
                                            width="20"
                                            height="2"
                                            fill="#ffffff"></rect>
                                        <rect
                                            x="18"
                                            y="19"
                                            width="10"
                                            height="2"
                                            fill="#ffffff"></rect>
                                    </svg>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>
<!-- header area end -->
