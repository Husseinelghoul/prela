---
import { Image } from "astro:assets";

// Dynamically import all logos from the brands folder
const images = import.meta.glob("../assets/brands/*.{png,jpg,jpeg,webp,svg}");

// Desired order based on user request:
// German: volkswagen, skoda, seat, audi, mercedes, bmw, porsche
// French: renault, peugeot, opel
// Japanese: toyota, honda, nissan, mazda
const order = [
    "volkswagen",
    "skoda",
    "seat",
    "audi",
    "mercedes",
    "bmw",
    "porsche",
    "renault",
    "peugeot",
    "opel",
    "toyota",
    "honda",
    "nissan",
    "mazda",
];

const brandImages = await Promise.all(
    order.map(async (brandName) => {
        const path = Object.keys(images).find((p) =>
            p.toLowerCase().includes(brandName.toLowerCase()),
        );
        if (path) {
            const module = (await images[path]()) as any;
            return {
                src: module.default,
                name: brandName,
            };
        }
        return null;
    }),
);

const filteredBrands = brandImages.filter((b) => b !== null) as {
    src: any;
    name: string;
}[];

// Triple the array for a seamless infinite loop
const slidingImages = [...filteredBrands, ...filteredBrands, ...filteredBrands];
---

<div class="brand-slider-container">
    <div class="brand-track">
        {
            slidingImages.map((brand) => (
                <a
                    href={`/quote?brand=${brand.name}`}
                    class="brand-item"
                    title={`Get a quote for ${brand.name}`}
                >
                    <div class="brand-card">
                        <Image
                            src={brand.src}
                            alt={`${brand.name} logo`}
                            width={360}
                            height={220}
                            format="webp"
                            quality="mid"
                            class="brand-logo"
                        />
                    </div>
                </a>
            ))
        }
    </div>
</div>

<style>
    .brand-slider-container {
        width: 100%;
        overflow: hidden;
        position: relative;
        padding: 20px 0; /* Reduced vertical padding to reduce whitespace */
        background: transparent;
        cursor: pointer;
    }

    /* Gradient masks for smooth fade in/out on edges */
    .brand-slider-container::before,
    .brand-slider-container::after {
        content: "";
        position: absolute;
        top: 0;
        width: 10vw;
        height: 100%;
        z-index: 2;
        pointer-events: none;
    }

    .brand-slider-container::before {
        left: 0;
        background: linear-gradient(to right, #ffffff, rgba(255, 255, 255, 0));
    }

    .brand-slider-container::after {
        right: 0;
        background: linear-gradient(to left, #ffffff, rgba(255, 255, 255, 0));
    }

    /* Dark mode support */
    :global([data-theme="dark"]) .brand-slider-container::before {
        background: linear-gradient(to right, #000000, rgba(0, 0, 0, 0));
    }
    :global([data-theme="dark"]) .brand-slider-container::after {
        background: linear-gradient(to left, #000000, rgba(0, 0, 0, 0));
    }

    .brand-track {
        display: flex;
        width: max-content;
        animation: scroll 40s linear infinite; /* Slightly faster since cards are bigger */
        will-change: transform;
    }

    .brand-slider-container:hover .brand-track {
        animation-play-state: paused;
    }

    .brand-item {
        flex: 0 0 auto;
        padding: 0 40px; /* More spacing between items */
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
    }

    .brand-card {
        width: 420px; /* Increased by another ~30% from 320px */
        height: 260px; /* Increased by another ~30% from 200px */
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 50px;
        background: #ffffff;
        border-radius: 30px;
        box-shadow:
            0 10px 20px rgba(0, 0, 0, 0.04),
            0 2px 6px rgba(0, 0, 0, 0.02);
        transition: all 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);
        border: 1px solid rgba(0, 0, 0, 0.02);
    }

    .brand-card:hover {
        transform: translateY(-12px) scale(1.05); /* Slightly more prominent lift */
        box-shadow:
            0 25px 50px rgba(0, 0, 0, 0.1),
            0 10px 20px rgba(0, 0, 0, 0.05);
        border-color: rgba(201, 161, 99, 0.3);
    }

    .brand-logo {
        max-width: 100%;
        max-height: 100%;
        width: auto;
        height: auto;
        object-fit: contain;
        filter: grayscale(100%) contrast(0.7);
        opacity: 0.5;
        transition: all 0.5s ease;
    }

    .brand-card:hover .brand-logo {
        filter: grayscale(0%) contrast(1);
        opacity: 1;
    }

    @keyframes scroll {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(calc(-100% / 3));
        }
    }

    /* Responsiveness */
    @media (max-width: 1200px) {
        .brand-card {
            width: 200px;
            height: 130px;
            padding: 30px;
        }
    }

    @media (max-width: 991px) {
        .brand-track {
            animation-duration: 30s;
        }
        .brand-item {
            padding: 0 25px;
        }
        .brand-card {
            width: 180px;
            height: 110px;
            padding: 20px;
        }
    }

    @media (max-width: 768px) {
        .brand-slider-container {
            padding: 10px 0;
        }
        .brand-track {
            animation-duration: 25s;
        }
        .brand-item {
            padding: 0 20px;
        }
        .brand-card {
            width: 150px;
            height: 100px;
            padding: 15px;
        }
        .brand-slider-container::before,
        .brand-slider-container::after {
            width: 50px;
        }
    }
</style>
