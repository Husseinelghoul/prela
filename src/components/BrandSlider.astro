---
import { Image } from "astro:assets";

// Dynamically import all logos from the brands folder
const images = import.meta.glob("../assets/brands/*.{png,jpg,jpeg,webp,svg}");

// Desired order based on user request:
// German: volkswagen, skoda, seat, audi, mercedes, bmw, porsche
// French: renault, peugeot, opel
// Japanese: toyota, honda, nissan, mazda
const order = [
    "volkswagen",
    "skoda",
    "seat",
    "audi",
    "mercedes",
    "bmw",
    "porsche",
    "renault",
    "peugeot",
    "opel",
    "toyota",
    "honda",
    "nissan",
    "mazda",
];

const brandImages = await Promise.all(
    order.map(async (brandName) => {
        const path = Object.keys(images).find((p) =>
            p.toLowerCase().includes(brandName.toLowerCase()),
        );
        if (path) {
            const module = (await images[path]()) as any;
            return {
                src: module.default,
                name: brandName,
            };
        }
        return null;
    }),
);

const filteredBrands = brandImages.filter((b) => b !== null) as {
    src: any;
    name: string;
}[];

// Triple the array for a seamless infinite loop
const slidingImages = [...filteredBrands, ...filteredBrands, ...filteredBrands];
---

<div class="brand-slider-container" id="brandSlider">
    <div class="brand-track">
        {
            slidingImages.map((brand) => (
                <a
                    href={`/bewertung?brand=${brand.name}`}
                    class="brand-item"
                    title={`Get a quote for ${brand.name}`}
                >
                    <div class="brand-card">
                        <Image
                            src={brand.src}
                            alt={`${brand.name} logo`}
                            width={360}
                            height={220}
                            format="webp"
                            quality="mid"
                            class="brand-logo"
                        />
                    </div>
                </a>
            ))
        }
    </div>
</div>

<script>
    const slider = document.getElementById("brandSlider");
    if (slider) {
        const track = slider.querySelector(".brand-track") as HTMLElement;
        let isDown = false;
        let startX: number;
        let scrollLeft: number;
        let animationId: number;
        let isPaused = false;
        let lastTimestamp = 0;
        let hasMoved = false;
        const speed = 0.05; // Pixels per millisecond

        // Initialize in the middle section for better bi-directional scrolling
        const initScroll = () => {
            if (track.scrollWidth > 0) {
                slider.scrollLeft = track.scrollWidth / 3;
            }
        };

        // Wait for images to load to get correct scrollWidth
        window.addEventListener("load", initScroll);
        // Also try immediately
        initScroll();

        const animate = (timestamp: number) => {
            if (isPaused) return;

            if (!lastTimestamp) lastTimestamp = timestamp;
            const delta = timestamp - lastTimestamp;
            lastTimestamp = timestamp;

            // Auto-scroll logic
            slider.scrollLeft += speed * delta;

            // Seamless loop
            if (slider.scrollLeft >= (track.scrollWidth * 2) / 3) {
                slider.scrollLeft -= track.scrollWidth / 3;
            }

            animationId = requestAnimationFrame(animate);
        };

        // Initialize animation
        animationId = requestAnimationFrame(animate);

        // Interaction handlers
        slider.addEventListener("mouseenter", () => {
            isPaused = true;
        });

        slider.addEventListener("mouseleave", () => {
            if (!isDown) {
                isPaused = false;
                lastTimestamp = 0;
                requestAnimationFrame(animate);
            }
        });

        // Drag functionality
        slider.addEventListener("mousedown", (e) => {
            isDown = true;
            hasMoved = false;
            slider.classList.add("active");
            startX = e.pageX - slider.offsetLeft;
            scrollLeft = slider.scrollLeft;
            isPaused = true;
        });

        window.addEventListener("mouseup", () => {
            if (!isDown) return;
            isDown = false;
            slider.classList.remove("active");

            // Resume after a short delay if not hovering
            setTimeout(() => {
                if (!isDown && !slider.matches(":hover")) {
                    isPaused = false;
                    lastTimestamp = 0;
                    requestAnimationFrame(animate);
                }
            }, 1500);
        });

        slider.addEventListener("mousemove", (e) => {
            if (!isDown) return;
            e.preventDefault();
            const x = e.pageX - slider.offsetLeft;
            const walk = (x - startX) * 2; // Scroll speed multiplier

            if (Math.abs(walk) > 5) {
                hasMoved = true;
            }

            slider.scrollLeft = scrollLeft - walk;

            // Loop check during drag
            if (slider.scrollLeft >= (track.scrollWidth * 2) / 3) {
                slider.scrollLeft -= track.scrollWidth / 3;
                scrollLeft -= track.scrollWidth / 3;
            } else if (slider.scrollLeft <= 0) {
                slider.scrollLeft += track.scrollWidth / 3;
                scrollLeft += track.scrollWidth / 3;
            }
        });

        // Prevent clicks if the user was dragging
        slider.addEventListener(
            "click",
            (e) => {
                if (hasMoved) {
                    e.preventDefault();
                    e.stopPropagation();
                }
            },
            true,
        );

        // Touch support
        slider.addEventListener(
            "touchstart",
            () => {
                isPaused = true;
                hasMoved = false;
            },
            { passive: true },
        );

        slider.addEventListener(
            "touchend",
            () => {
                setTimeout(() => {
                    if (!isDown) {
                        isPaused = false;
                        lastTimestamp = 0;
                        requestAnimationFrame(animate);
                    }
                }, 2000);
            },
            { passive: true },
        );

        // Multi-directional loop for manual scrolling (touch/drag)
        slider.addEventListener(
            "scroll",
            () => {
                if (slider.scrollLeft >= (track.scrollWidth * 2) / 3) {
                    slider.scrollLeft -= track.scrollWidth / 3;
                } else if (slider.scrollLeft <= 0) {
                    slider.scrollLeft += track.scrollWidth / 3;
                }
            },
            { passive: true },
        );
    }
</script>

<style>
    .brand-slider-container {
        width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        position: relative;
        padding: 20px 0;
        background: transparent;
        cursor: grab;
        scrollbar-width: none; /* Hide scrollbar Firefox */
        -ms-overflow-style: none; /* Hide scrollbar IE/Edge */
        -webkit-overflow-scrolling: touch;
        user-select: none;
    }

    .brand-slider-container::-webkit-scrollbar {
        display: none; /* Hide scrollbar Chrome/Safari */
    }

    .brand-slider-container.active {
        cursor: grabbing;
        cursor: -webkit-grabbing;
    }

    /* Gradient masks */
    .brand-slider-container::before,
    .brand-slider-container::after {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        width: 10vw;
        z-index: 10;
        pointer-events: none;
    }

    .brand-slider-container::before {
        left: 0;
        background: linear-gradient(to right, #ffffff, rgba(255, 255, 255, 0));
    }

    .brand-slider-container::after {
        right: 0;
        background: linear-gradient(to left, #ffffff, rgba(255, 255, 255, 0));
    }

    :global([data-theme="dark"]) .brand-slider-container::before {
        background: linear-gradient(to right, #000000, rgba(0, 0, 0, 0));
    }
    :global([data-theme="dark"]) .brand-slider-container::after {
        background: linear-gradient(to left, #000000, rgba(0, 0, 0, 0));
    }

    .brand-track {
        display: flex;
        width: max-content;
        will-change: transform;
    }

    .brand-item {
        flex: 0 0 auto;
        padding: 0 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
    }

    .brand-card {
        width: 420px;
        height: 260px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 50px;
        background: #ffffff;
        border-radius: 30px;
        box-shadow:
            0 10px 20px rgba(0, 0, 0, 0.04),
            0 2px 6px rgba(0, 0, 0, 0.02);
        transition:
            transform 0.5s cubic-bezier(0.165, 0.84, 0.44, 1),
            box-shadow 0.5s ease,
            border-color 0.5s ease;
        border: 1px solid rgba(0, 0, 0, 0.02);
    }

    .brand-card:hover {
        transform: translateY(-12px) scale(1.05);
        box-shadow:
            0 25px 50px rgba(0, 0, 0, 0.1),
            0 10px 20px rgba(0, 0, 0, 0.05);
        border-color: rgba(201, 161, 99, 0.3);
    }

    .brand-logo {
        max-width: 100%;
        max-height: 100%;
        width: auto;
        height: auto;
        object-fit: contain;
        filter: grayscale(100%) contrast(0.7);
        opacity: 0.5;
        transition: all 0.5s ease;
        pointer-events: none; /* Prevent logo dragging */
    }

    .brand-card:hover .brand-logo {
        filter: grayscale(0%) contrast(1);
        opacity: 1;
    }

    /* Responsiveness */
    @media (max-width: 1200px) {
        .brand-card {
            width: 200px;
            height: 130px;
            padding: 30px;
        }
    }

    @media (max-width: 991px) {
        .brand-item {
            padding: 0 25px;
        }
        .brand-card {
            width: 180px;
            height: 110px;
            padding: 20px;
        }
    }

    @media (max-width: 768px) {
        .brand-slider-container {
            padding: 10px 0;
        }
        .brand-item {
            padding: 0 20px;
        }
        .brand-card {
            width: 150px;
            height: 100px;
            padding: 15px;
        }
        .brand-slider-container::before,
        .brand-slider-container::after {
            width: 50px;
        }
    }
</style>
