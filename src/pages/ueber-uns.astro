---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import ContactForm from "../components/ContactForm.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
    title="Über Prela Automobile AG – Autohändler in Sursee"
    description="Lernen Sie Prela Automobile AG kennen – Ihr Autohändler in Sursee, Luzern. Familienbetrieb mit über 25 Jahren Erfahrung im Autoankauf, Autoverkauf und Autoexport. Faire Preise, persönlicher Service."
    alternates={[{ lang: 'de-CH', href: '/ueber-uns' }, { lang: 'fr-CH', href: '/fr/a-propos' }]}
>
    <div class="rts-wrapper">
        <div class="rts-wrapper-inner">
            <Header altHref="/fr/a-propos" />

            <Breadcrumb
                title="Über Prela Automobile AG"
                current="Über Uns"
                className="service"
            />

            <!-- Mission & Vision Section Start -->
            <section class="rts-about-area rts-section-gap">
                <div class="container">
                    <div class="row g-5">
                        <div class="col-lg-6">
                            <div class="about-content-area">
                                <div class="section-title-area">
                                    <p class="sub-title">Unsere Mission</p>
                                    <h2 class="section-title">
                                        Ihr <span>Autoverkauf</span> – einfach gemacht
                                    </h2>
                                </div>
                                <p class="desc">
                                    Bei Prela Automobile AG wollen wir den Autohandel in der Schweiz
                                    so einfach wie möglich machen. Ob Sie Ihr <a href="/bewertung">Auto verkaufen</a>,
                                    ein Fahrzeug kaufen oder exportieren möchten – wir sorgen für
                                    Transparenz und Vertrauen bei jedem Geschäft. Unser Ziel ist es,
                                    Ihnen den besten Wert und einen reibungslosen Ablauf zu bieten.
                                </p>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="about-content-area">
                                <div class="section-title-area">
                                    <p class="sub-title">Unsere Vision</p>
                                    <h2 class="section-title">
                                        Der Massstab für <span>Qualität</span>
                                    </h2>
                                </div>
                                <p class="desc">
                                    Unsere Vision ist es, der führende Autohändler in der Schweiz zu werden.
                                    Wir setzen auf ständige Verbesserung unserer Dienstleistungen und möchten,
                                    dass Prela Automobile AG die erste Wahl für alle ist, die ein
                                    <a href="/tipps/auto-kaufen">Auto kaufen</a> oder verkaufen möchten.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <!-- Mission & Vision Section End -->

            <!-- Value Proposition Start -->
            <section class="rts-service-area rts-section-gap bg-light">
                <div class="container">
                    <div class="section-title-area text-center">
                        <p class="sub-title">Warum Prela?</p>
                        <h2 class="section-title">
                            Unsere <span>Vorteile</span>
                        </h2>
                    </div>
                    <div class="row g-5 mt--20">
                        <div class="col-lg-4 col-md-6">
                            <div class="service-wrapper text-center">
                                <div class="icon mb--20">
                                    <img
                                        src="/images/why-choose/icon-01.svg"
                                        alt="Faire Autobewertung Icon"
                                        width="60"
                                        loading="lazy"
                                        decoding="async"
                                    />
                                </div>
                                <h5 class="title">Faire Bewertung</h5>
                                <p class="desc">
                                    Wir nutzen aktuelle Marktdaten, um Ihnen den
                                    besten und fairsten Preis für Ihr Fahrzeug zu
                                    bieten. Egal ob Verkauf oder Inzahlungnahme –
                                    bei uns stimmt der Preis.
                                </p>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <div class="service-wrapper text-center">
                                <div class="icon mb--20">
                                    <img
                                        src="/images/why-choose/icon-02.svg"
                                        alt="Professioneller Autoexport Icon"
                                        width="60"
                                        loading="lazy"
                                        decoding="async"
                                    />
                                </div>
                                <h5 class="title">Professioneller Export</h5>
                                <p class="desc">
                                    Mit jahrelanger Erfahrung in der internationalen
                                    Logistik wickeln wir den
                                    <a href="/tipps/auto-exportieren">Autoexport</a>
                                    komplett für Sie ab – Papierkram und Transport inklusive.
                                </p>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <div class="service-wrapper text-center">
                                <div class="icon mb--20">
                                    <img
                                        src="/images/why-choose/icon-03.svg"
                                        alt="Geprüfte Qualität Icon"
                                        width="60"
                                        loading="lazy"
                                        decoding="async"
                                    />
                                </div>
                                <h5 class="title">Geprüfte Qualität</h5>
                                <p class="desc">
                                    Jedes Fahrzeug in unserem Bestand wird gründlich
                                    geprüft. So garantieren wir höchste Sicherheits-
                                    und Qualitätsstandards.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <!-- Value Proposition End -->

            <!-- History of Owners Start -->
            <section class="rts-about-area rts-section-gap">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-lg-5">
                            <div class="about-image-area">
                                <img
                                    src="/images/about/03.webp"
                                    alt="Prela Familie – Gründer von Prela Automobile AG Sursee"
                                    class="radius-10"
                                    loading="lazy"
                                    decoding="async"
                                />
                            </div>
                        </div>
                        <div class="col-lg-7">
                            <div class="about-content-area">
                                <div class="section-title-area">
                                    <p class="sub-title">Unsere Geschichte</p>
                                    <h2 class="section-title">
                                        Über 25 Jahre <span>Leidenschaft</span>
                                    </h2>
                                </div>
                                <p class="desc">
                                    Gegründet von der Familie Prela, begann unser
                                    Unternehmen als kleine Garage in Sursee – mit
                                    grosser Leidenschaft für Autos und Technik.
                                    Über die Jahre sind wir zur Prela Automobile AG
                                    gewachsen, einem festen Teil des Schweizer Automarkts.
                                </p>
                                <p class="desc">
                                    Die Gründer bringen umfangreiche Erfahrung in
                                    Mechanik und internationalem Handel mit. Persönliche
                                    Kundenbeziehungen standen immer an erster Stelle.
                                    Heute führt dieselbe familiengetriebene Leidenschaft
                                    unsere Arbeit – damit Prela Automobile AG für
                                    Vertrauen und Qualität steht.
                                </p>
                                <p class="desc">
                                    <strong
                                        >Unser Vorteil: Wir kommen aus der professionellen
                                        Autowerkstatt. Diese technische Expertise macht
                                        uns zu einem einzigartigen Autohändler in der
                                        Schweiz.</strong>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <!-- History of Owners End -->

            <div class="rts-cta-area area-2">
                <div class="container">
                    <div class="cta-inner">
                        <h2 class="title">
                            Bereit, den Prela-Unterschied zu erleben?
                        </h2>
                        <div class="contact">
                            <a href="callto:+41793088000">
                                <img
                                    src="/images/cta/call.svg"
                                    alt="Telefon Icon"
                                    loading="lazy"
                                />
                                +41 79 308 80 00</a
                            >
                        </div>
                    </div>
                </div>
            </div>

            <!-- End of Page Form -->
            <section class="rts-contact-area rts-section-gap">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-8 offset-lg-2">
                            <ContactForm />
                        </div>
                    </div>
                </div>
            </section>

            <Footer />
        </div>
    </div>
</BaseLayout>
