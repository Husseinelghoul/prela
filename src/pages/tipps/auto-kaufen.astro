---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Footer from "../../components/Footer.astro";
import ContactForm from "../../components/ContactForm.astro";
---

<BaseLayout
    title="Auto kaufen Schweiz – Worauf Sie achten sollten"
    description="Auto kaufen in der Schweiz: Tipps zu Probefahrt, Servicehistorie, Karosseriezustand, Garantie und mehr. Ratgeber von Prela Automobile AG – Ihrem Autohändler in Luzern."
>
    <div class="rts-wrapper">
        <div class="rts-wrapper-inner">
            <Header />

            <Breadcrumb
                title="Auto kaufen – Tipps"
                current="Auto kaufen"
                className="service"
            />

            <!-- Main Article -->
            <article class="rts-blog-article rts-section-gap">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-10">

                            <!-- Intro Section -->
                            <div class="article-intro mb--40">
                                <img
                                    src="/images/blog/02.webp"
                                    alt="Auto kaufen in der Schweiz – Tipps für den Gebrauchtwagenkauf"
                                    class="article-hero-img radius-10"
                                    width="1200"
                                    height="600"
                                    loading="eager"
                                    decoding="async"
                                />
                                <div class="mt--30">
                                    <h1>Auto kaufen in der Schweiz – worauf Sie achten sollten</h1>
                                    <p class="lead">
                                        Ein Autokauf ist eine grosse Investition. Ob neues oder
                                        gebrauchtes Fahrzeug – mit unseren Tipps aus über 25 Jahren
                                        Erfahrung im Autohandel schützen Sie sich vor bösen Überraschungen
                                        und finden das perfekte Fahrzeug zum besten Preis.
                                    </p>
                                </div>
                            </div>

                            <!-- Section 1 -->
                            <section class="article-section mb--40">
                                <h2>1. Servicehistorie und Dokumentation prüfen</h2>
                                <p>
                                    Ein gut dokumentiertes Fahrzeug spricht für verantwortungsvolle
                                    Vorbesitzer. Achten Sie auf:
                                </p>
                                <ul class="article-list">
                                    <li>
                                        <strong>Lückenloses Serviceheft:</strong> Regelmässige Wartung
                                        bei autorisierten Werkstätten ist ein gutes Zeichen.
                                    </li>
                                    <li>
                                        <strong>MFK-Prüfbericht:</strong> Wann war die letzte Motorfahrzeugkontrolle?
                                        Ein frischer MFK-Bericht zeigt den technischen Zustand.
                                    </li>
                                    <li>
                                        <strong>Kilometerstand:</strong> Passt der Kilometerstand zum
                                        Alter des Fahrzeugs? Durchschnittlich fährt ein Schweizer
                                        12'000–15'000 km pro Jahr.
                                    </li>
                                    <li>
                                        <strong>Vorbesitzer:</strong> Weniger Vorbesitzer bedeutet
                                        oft bessere Pflege und weniger Verschleiss.
                                    </li>
                                </ul>
                            </section>

                            <!-- Section 2 -->
                            <section class="article-section mb--40">
                                <h2>2. Karosseriezustand genau untersuchen</h2>
                                <p>
                                    Der äussere Zustand verrät viel über die Geschichte eines Fahrzeugs:
                                </p>
                                <ul class="article-list">
                                    <li>
                                        <strong>Lackabweichungen:</strong> Unterschiedliche Farbtöne
                                        oder Lacknebel können auf eine Nachlackierung hinweisen – ein
                                        Zeichen für reparierte Unfallschäden.
                                    </li>
                                    <li>
                                        <strong>Spaltmasse:</strong> Ungleichmässige Abstände zwischen
                                        Türen, Motorhaube und Kofferraum deuten auf frühere Unfälle hin.
                                    </li>
                                    <li>
                                        <strong>Rost:</strong> Prüfen Sie die Radkästen, Schweller und
                                        den Unterboden auf Rostbefall.
                                    </li>
                                    <li>
                                        <strong>Glas:</strong> Risse in der Windschutzscheibe können
                                        bei der MFK-Prüfung zum Problem werden.
                                    </li>
                                </ul>
                            </section>

                            <!-- Section 3 -->
                            <section class="article-section mb--40">
                                <h2>3. Probefahrt – darauf kommt es an</h2>
                                <p>
                                    Eine gründliche Probefahrt ist Pflicht. Achten Sie auf folgende Punkte:
                                </p>
                                <ul class="article-list">
                                    <li>
                                        <strong>Kaltstart:</strong> Starten Sie den Motor kalt. Ungewöhnliche
                                        Geräusche bei Kaltstart können auf Probleme hinweisen.
                                    </li>
                                    <li>
                                        <strong>Getriebe:</strong> Testen Sie alle Gänge. Bei Automatik
                                        sollten die Schaltvorgänge sanft und ruckfrei sein.
                                    </li>
                                    <li>
                                        <strong>Bremsen:</strong> Bremst das Fahrzeug gleichmässig?
                                        Vibrationen oder Geräusche beim Bremsen sind Warnsignale.
                                    </li>
                                    <li>
                                        <strong>Elektronik:</strong> Prüfen Sie alle elektronischen
                                        Funktionen: Klimaanlage, Fensterheber, Radio, Navi und Assistenzsysteme.
                                    </li>
                                </ul>
                            </section>

                            <!-- Section 4 -->
                            <section class="article-section mb--40">
                                <h2>4. Garantie und Gewährleistung</h2>
                                <p>
                                    Der Kauf beim Händler bietet wichtige rechtliche Vorteile gegenüber
                                    dem Privatkauf:
                                </p>
                                <ul class="article-list">
                                    <li>
                                        <strong>Händlergarantie:</strong> Seriöse <a href="/ueber-uns">Autohändler wie Prela Automobile AG</a>
                                        bieten eine umfassende Garantie auf ihre Gebrauchtwagen.
                                    </li>
                                    <li>
                                        <strong>Rückgaberecht:</strong> Je nach Vertrag können Sie
                                        das Fahrzeug innerhalb einer Frist zurückgeben.
                                    </li>
                                    <li>
                                        <strong>Qualitätsprüfung:</strong> Händlerfahrzeuge werden
                                        vor dem Verkauf professionell geprüft und aufbereitet.
                                    </li>
                                </ul>
                            </section>

                            <!-- Section 5 -->
                            <section class="article-section mb--40">
                                <h2>5. Finanzierung und Versicherung</h2>
                                <p>
                                    Planen Sie neben dem Kaufpreis auch die laufenden Kosten ein:
                                </p>
                                <ul class="article-list">
                                    <li>
                                        <strong>Versicherung:</strong> Holen Sie vor dem Kauf
                                        Offerten für Haftpflicht und Kasko ein.
                                    </li>
                                    <li>
                                        <strong>Steuern:</strong> Die Motorfahrzeugsteuer variiert
                                        je nach Kanton und Fahrzeugtyp.
                                    </li>
                                    <li>
                                        <strong>Finanzierung:</strong> Wir arbeiten mit Schweizer
                                        Finanzpartnern zusammen und helfen Ihnen, die besten
                                        Konditionen zu finden. <a href="/kontakt">Kontaktieren Sie uns</a>.
                                    </li>
                                </ul>
                            </section>

                            <!-- CTA -->
                            <div class="article-cta text-center mt--60">
                                <h3>Ihr Traumauto wartet auf Sie!</h3>
                                <p>
                                    Entdecken Sie unsere Auswahl an geprüften Gebrauchtwagen –
                                    jedes Fahrzeug ist professionell aufbereitet und mit Garantie.
                                </p>
                                <a
                                    href="https://www.autoscout24.ch/de/s/seller-2466620"
                                    target="_blank"
                                    class="rts-btn btn-primary radius-pill"
                                >
                                    Unsere Fahrzeuge ansehen
                                </a>
                            </div>

                            <!-- Related Links -->
                            <div class="related-links mt--60">
                                <h4>Weitere Tipps</h4>
                                <ul>
                                    <li><a href="/tipps/auto-verkaufen">Auto verkaufen in der Schweiz – Tipps für den besten Preis</a></li>
                                    <li><a href="/tipps/auto-exportieren">Auto aus der Schweiz exportieren – Ihr Leitfaden</a></li>
                                </ul>
                            </div>

                        </div>
                    </div>
                </div>
            </article>

            <!-- Article Schema -->
            <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "Article",
                "headline": "Auto kaufen in der Schweiz – Worauf Sie achten sollten",
                "description": "Tipps zum Autokauf in der Schweiz: Probefahrt, Servicehistorie, Karosseriezustand, Garantie und Finanzierung. Vom Experten erklärt.",
                "author": {
                    "@type": "Organization",
                    "name": "Prela Automobile AG"
                },
                "publisher": {
                    "@type": "Organization",
                    "name": "Prela Automobile AG",
                    "logo": {
                        "@type": "ImageObject",
                        "url": "https://prela-automobile.ch/images/logo/prela_logo.webp"
                    }
                },
                "datePublished": "2026-03-25",
                "dateModified": "2026-03-25",
                "image": "https://prela-automobile.ch/images/blog/02.webp",
                "inLanguage": "de-CH"
            }
            </script>

            <!-- End of Page Form -->
            <section class="rts-contact-area rts-section-gap">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-8 offset-lg-2">
                            <ContactForm />
                        </div>
                    </div>
                </div>
            </section>

            <Footer />
        </div>
    </div>
</BaseLayout>

<style>
    .article-hero-img {
        width: 100%;
        height: auto;
        object-fit: cover;
        max-height: 500px;
    }

    .article-intro .lead {
        font-size: 18px;
        line-height: 1.7;
        color: #555;
    }

    .article-section h2 {
        font-size: 28px;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 15px;
        padding-bottom: 10px;
        border-bottom: 2px solid #f0f0f0;
    }

    .article-section p {
        font-size: 16px;
        line-height: 1.8;
        color: #444;
        margin-bottom: 15px;
    }

    .article-list {
        list-style: none;
        padding: 0;
    }

    .article-list li {
        position: relative;
        padding-left: 25px;
        margin-bottom: 12px;
        font-size: 16px;
        line-height: 1.7;
        color: #444;
    }

    .article-list li::before {
        content: "✓";
        position: absolute;
        left: 0;
        color: var(--color-primary);
        font-weight: 700;
    }

    .article-cta {
        background: #f8f9fa;
        padding: 40px;
        border-radius: 15px;
        border: 1px solid #e9ecef;
    }

    .article-cta h3 {
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .article-cta p {
        color: #666;
        margin-bottom: 20px;
    }

    .related-links {
        border-top: 2px solid #f0f0f0;
        padding-top: 30px;
    }

    .related-links h4 {
        font-size: 20px;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .related-links li {
        margin-bottom: 10px;
    }

    .related-links a {
        color: var(--color-primary);
        text-decoration: underline;
        font-size: 16px;
    }

    @media (max-width: 768px) {
        .article-section h2 {
            font-size: 22px;
        }

        .article-cta {
            padding: 25px;
        }
    }
</style>
