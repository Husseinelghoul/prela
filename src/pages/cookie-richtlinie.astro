---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const lastMonth = new Date();
lastMonth.setMonth(lastMonth.getMonth() - 1);
const formattedDate = lastMonth.toLocaleString("de-CH", {
    month: "long",
    year: "numeric",
});
---

<BaseLayout
    title="Cookie-Richtlinie – Prela Automobile AG"
    description="Cookie-Richtlinie von Prela Automobile AG. Erfahren Sie, welche Cookies wir verwenden, warum und wie Sie diese verwalten können."
>
    <div class="rts-wrapper">
        <div class="rts-wrapper-inner">
            <Header />

            <div class="legal-hero">
                <div class="container">
                    <div class="legal-hero-inner">
                        <div class="legal-icon"><i class="fa-light fa-cookie-bite"></i></div>
                        <h1>Cookie-Richtlinie</h1>
                        <p class="legal-subtitle">Erfahren Sie, wie wir Cookies einsetzen, um Ihr Erlebnis zu verbessern.</p>
                        <div class="legal-meta">
                            <span class="meta-item"><i class="fa-light fa-calendar"></i> Aktualisiert: {formattedDate}</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="legal-content-area rts-section-gap">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-10">
                            <div class="legal-content">

                                <div class="legal-section">
                                    <div class="section-number">01</div>
                                    <h2>Was sind Cookies?</h2>
                                    <p>Cookies sind kleine Textdateien, die auf Ihrem Computer oder Mobilgerät gespeichert werden, wenn Sie unsere Website besuchen. Sie helfen uns, Ihnen ein besseres Erlebnis zu bieten, indem sie Ihre Einstellungen speichern und verstehen, wie Sie unsere Website nutzen.</p>
                                </div>

                                <div class="legal-section">
                                    <div class="section-number">02</div>
                                    <h2>Welche Cookies wir verwenden</h2>
                                    <div class="cookie-types">
                                        <div class="cookie-card essential">
                                            <div class="cookie-badge">Notwendig</div>
                                            <h5><i class="fa-light fa-gear"></i> Essentielle Cookies</h5>
                                            <p>Diese Cookies sind für die grundlegende Funktion der Website erforderlich. Sie ermöglichen die Navigation und den Zugriff auf geschützte Bereiche.</p>
                                        </div>
                                        <div class="cookie-card analytics">
                                            <div class="cookie-badge">Optional</div>
                                            <h5><i class="fa-light fa-chart-pie"></i> Analyse-Cookies</h5>
                                            <p>Diese Cookies helfen uns zu verstehen, wie Besucher mit unserer Website interagieren, indem sie anonymisierte Informationen erfassen.</p>
                                        </div>
                                        <div class="cookie-card functional">
                                            <div class="cookie-badge">Optional</div>
                                            <h5><i class="fa-light fa-sliders"></i> Funktionale Cookies</h5>
                                            <p>Diese Cookies ermöglichen der Website, sich an Ihre Auswahl zu erinnern und erweiterte, personalisierte Funktionen bereitzustellen.</p>
                                        </div>
                                        <div class="cookie-card marketing">
                                            <div class="cookie-badge">Optional</div>
                                            <h5><i class="fa-light fa-bullhorn"></i> Marketing-Cookies</h5>
                                            <p>Diese Cookies verfolgen Ihre Online-Aktivitäten, um relevantere Werbung zu liefern oder die Häufigkeit einer Anzeige zu begrenzen.</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="legal-section">
                                    <div class="section-number">03</div>
                                    <h2>Wofür wir Cookies verwenden</h2>
                                    <ul class="legal-list">
                                        <li>Ihre Einstellungen für zukünftige Besuche speichern</li>
                                        <li>Aggregierte Daten über Website-Traffic und Interaktionen kompilieren</li>
                                        <li>Unsere Website und Dienstleistungen verbessern</li>
                                        <li>Ihnen ein personalisiertes Erlebnis bieten</li>
                                    </ul>
                                </div>

                                <div class="legal-section">
                                    <div class="section-number">04</div>
                                    <h2>Cookies verwalten</h2>
                                    <p>Sie können Cookies jederzeit kontrollieren und löschen. Sie können alle bereits gespeicherten Cookies entfernen und die meisten Browser so einstellen, dass keine Cookies platziert werden.</p>
                                    <div class="highlight-box">
                                        <i class="fa-light fa-circle-info"></i>
                                        <p><strong>Hinweis:</strong> Wenn Sie Cookies deaktivieren, müssen Sie möglicherweise bei jedem Besuch einige Einstellungen manuell vornehmen, und gewisse Funktionen können eingeschränkt sein.</p>
                                    </div>
                                </div>

                                <div class="legal-section">
                                    <div class="section-number">05</div>
                                    <h2>Kontakt</h2>
                                    <p>Bei Fragen zur Cookie-Nutzung erreichen Sie uns unter:</p>
                                    <div class="contact-card">
                                        <strong>Prela Automobile AG</strong><br/>
                                        Allmendstrasse 10, 6210 Sursee, Schweiz<br/>
                                        E-Mail: <a href="mailto:info@prela-automobile.ch">info@prela-automobile.ch</a><br/>
                                        Telefon: <a href="tel:+41793088000">+41 79 308 80 00</a>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <Footer />
        </div>
    </div>
</BaseLayout>

<style>
    .legal-hero{background:linear-gradient(135deg,#0a1628 0%,#1a3a5c 50%,#0d2137 100%);padding:80px 0 60px;text-align:center;position:relative;overflow:hidden}
    .legal-hero::before{content:'';position:absolute;inset:0;background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");opacity:.5}
    .legal-hero-inner{position:relative;z-index:1}
    .legal-icon{width:80px;height:80px;background:rgba(255,255,255,.1);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.15);border-radius:20px;display:flex;align-items:center;justify-content:center;margin:0 auto 25px;font-size:36px;color:#4da6ff}
    .legal-hero h1{font-size:38px;font-weight:700;color:#fff;margin-bottom:15px}
    .legal-subtitle{font-size:18px;color:rgba(255,255,255,.7);max-width:500px;margin:0 auto 25px}
    .legal-meta{display:flex;justify-content:center;gap:30px;flex-wrap:wrap}
    .meta-item{font-size:14px;color:rgba(255,255,255,.5);display:flex;align-items:center;gap:8px}
    .legal-content{max-width:800px;margin:0 auto}
    .legal-section{margin-bottom:45px}
    .section-number{font-size:48px;font-weight:800;color:rgba(5,83,154,.06);line-height:1;margin-bottom:-10px}
    .legal-section h2{font-size:24px;font-weight:700;color:#1a1a1a;margin-bottom:15px;padding-bottom:12px;border-bottom:2px solid #f0f0f0}
    .legal-section p{font-size:16px;line-height:1.8;color:#555;margin-bottom:15px}
    .legal-list{list-style:none;padding:0;margin:15px 0}
    .legal-list li{position:relative;padding-left:28px;margin-bottom:10px;font-size:16px;line-height:1.7;color:#555}
    .legal-list li::before{content:'';position:absolute;left:0;top:10px;width:8px;height:8px;border-radius:50%;background:var(--color-primary)}
    .highlight-box{background:linear-gradient(135deg,#f0f7ff,#e8f0fe);border-left:4px solid var(--color-primary);border-radius:0 12px 12px 0;padding:20px 25px;display:flex;align-items:flex-start;gap:15px;margin:20px 0}
    .highlight-box i{font-size:24px;color:var(--color-primary);flex-shrink:0}
    .highlight-box p{margin:0;font-size:15px;color:#333}
    .cookie-types{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;margin:25px 0}
    .cookie-card{background:#fff;border:1px solid #eef2f7;border-radius:16px;padding:25px;position:relative;transition:transform .3s,box-shadow .3s}
    .cookie-card:hover{transform:translateY(-3px);box-shadow:0 10px 30px rgba(0,0,0,.08)}
    .cookie-badge{position:absolute;top:15px;right:15px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;padding:4px 10px;border-radius:20px;background:#e8f5e9;color:#2e7d32}
    .cookie-card.essential .cookie-badge{background:#fff3e0;color:#e65100}
    .cookie-card h5{font-size:17px;font-weight:700;color:#1a1a1a;margin-bottom:10px;display:flex;align-items:center;gap:10px}
    .cookie-card h5 i{color:var(--color-primary);font-size:20px}
    .cookie-card p{font-size:14px;line-height:1.6;color:#777;margin:0}
    .contact-card{background:#f8f9fa;border-radius:12px;padding:25px;border:1px solid #e9ecef;font-size:16px;line-height:1.8;color:#444}
    .contact-card a{color:var(--color-primary);text-decoration:none}
    .contact-card a:hover{text-decoration:underline}
    @media(max-width:768px){.legal-hero h1{font-size:28px}.cookie-types{grid-template-columns:1fr}.legal-hero{padding:60px 0 40px}.section-number{font-size:36px}}
</style>
