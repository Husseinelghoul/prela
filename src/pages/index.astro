---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FAQSection from "../components/FAQSection.astro";
import ContactForm from "../components/ContactForm.astro";
import BrandSlider from "../components/BrandSlider.astro";
---

<BaseLayout
    title="Auto verkaufen Schweiz – Sofort Bestpreis"
    description="Auto verkaufen zum Bestpreis bei Prela Automobile AG in Luzern. Kostenlose Autobewertung in 24 Stunden, Autoankauf aller Marken, Sofortzahlung. Über 25 Jahre Erfahrung."
>
    <div class="rts-wrapper">
        <div class="rts-wrapper-inner">
            <!-- header area start -->
            <Header />
            <!-- header area end -->

            <!-- Banner area start -->
            <section class="rts-banner-area bg_image_one jarallax">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="banner-area-one bg_image">
                                <div class="banner-content-area text-center">
                                    <div
                                        class="pre-title wow fadeInUp"
                                        data-wow-delay=".2s"
                                        data-wow-duration="1s"
                                    >
                                        <span
                                            >Ihr Autohändler in Luzern</span
                                        >
                                    </div>
                                    <h1
                                        class="title wow fadeInUp"
                                        data-wow-delay=".4s"
                                        data-wow-duration="1s"
                                    >
                                        Auto verkaufen zum Bestpreis
                                    </h1>
                                    <p
                                        class="desc wow fadeInUp"
                                        data-wow-delay=".6s"
                                        data-wow-duration="1s"
                                        style="color: white; font-size: 20px; font-weight: 500;"
                                    >
                                        Kostenlose Autobewertung – Sofort-Angebot – Über 25 Jahre Erfahrung
                                    </p>
                                    <div
                                        class="wow fadeInUp mobile-banner-btn"
                                        data-wow-delay=".8s"
                                        data-wow-duration="1s"
                                    >
                                        <a
                                            href="/bewertung"
                                            class="rts-btn radius-big icon btn-primary"
                                        >
                                            Gratis Bewertung erhalten
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <!-- Banner area end -->

            <!-- Form after Landing -->
            <section class="rts-contact-area rts-section-gapTop">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-8 offset-lg-2">
                            <ContactForm />
                        </div>
                    </div>
                </div>
            </section>

            <!-- About Area Start -->
            <section class="rts-about-area rts-section-gap">
                <div class="container">
                    <div class="section-inner">
                        <div class="row align-items-center">
                            <div class="col-lg-5">
                                <div class="about-image-area">
                                    <div class="image-main">
                                        <img
                                            class="wow scaleIn"
                                            data-wow-delay=".5s"
                                            data-wow-duration="1.5s"
                                            src="/images/about/03.webp"
                                            width="371"
                                            height="371"
                                            alt="Prela Automobile AG – Premium Autohaus in Sursee Luzern"
                                            loading="lazy"
                                            decoding="async"
                                        />
                                        <div class="counter-area">
                                            <div
                                                class="inner wow zoomIn"
                                                data-wow-delay=".9s"
                                                data-wow-duration="1s"
                                            >
                                                <h2 class="title text-blue">
                                                    <span class="counter"
                                                        >2000</span
                                                    ><span>+</span>
                                                </h2>
                                                <p class="desc text-blue">
                                                    Autos gekauft
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                    <img
                                        src="/images/about/01.webp"
                                        alt="Professionelle Fahrzeuginspektion bei Prela Automobile"
                                        width="223"
                                        height="223"
                                        class="floating-img-01 wow scaleIn"
                                        data-wow-delay=".5s"
                                        data-wow-duration="1.5s"
                                        loading="lazy"
                                        decoding="async"
                                    />
                                    <img
                                        src="/images/about/02.webp"
                                        alt="Hochwertiger Fahrzeuginnenraum – Gebrauchtwagen kaufen"
                                        width="266"
                                        height="266"
                                        class="floating-img-02 wow scaleIn"
                                        data-wow-delay=".5s"
                                        data-wow-duration="1.5s"
                                        loading="lazy"
                                        decoding="async"
                                    />
                                </div>
                            </div>
                            <div class="col-lg-7">
                                <div class="about-content-area pl--40">
                                    <div class="section-title-area">
                                        <p
                                            class="sub-title wow fadeInUp"
                                            data-wow-delay=".1s"
                                            data-wow-duration=".8s"
                                        >
                                            Über Prela Automobile AG
                                        </p>
                                        <h2
                                            class="section-title wow move-right"
                                        >
                                            Ihr vertrauenswürdiger Partner für den <span
                                                >Autoankauf in der Schweiz</span
                                            >
                                        </h2>
                                    </div>
                                    <p class="desc">
                                        Willkommen bei Prela Automobile AG – Ihrem Autohändler in Luzern.
                                        Mit über 25 Jahren Erfahrung im Schweizer Automarkt bieten wir Ihnen
                                        faire Preise, schnelle Abwicklung und einen persönlichen Service,
                                        auf den Sie sich verlassen können.
                                    </p>
                                    <p class="desc">
                                        <strong
                                            >Was uns besonders macht: Wir kommen aus der
                                            professionellen Autowerkstatt. Das heisst, wir kennen
                                            den echten Wert jedes Fahrzeugs – und geben diesen
                                            Vorteil an Sie weiter.</strong
                                        >
                                    </p>
                                    <a
                                        href="/ueber-uns"
                                        class="rts-btn btn-primary radius-big"
                                        >Mehr über uns erfahren</a
                                    >
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <!-- About Area End -->

            <!-- Counter Area Start -->
            <section class="rts-counter-area jarallax">
                <div class="container">
                    <div class="counter-inner">
                        <div
                            class="inner wow zoomIn"
                            data-wow-delay=".2s"
                            data-wow-duration="1s"
                        >
                            <div class="icon">
                                <img
                                    src="/images/counter/icon-01.svg"
                                    width="74"
                                    height="74"
                                    alt="Erfahrung Icon – über 25 Jahre im Autohandel"
                                    loading="lazy"
                                />
                            </div>
                            <div class="text">
                                <h3 class="title cw">
                                    <span class="counter">25</span><span>+</span
                                    >
                                </h3>
                                <p class="desc">Jahre Erfahrung</p>
                            </div>
                        </div>
                        <div
                            class="inner wow zoomIn"
                            data-wow-delay=".4s"
                            data-wow-duration="1s"
                        >
                            <div class="icon">
                                <img
                                    src="/images/counter/icon-02.svg"
                                    alt="Zufriedene Kunden Icon"
                                    width="80"
                                    height="80"
                                    loading="lazy"
                                />
                            </div>
                            <div class="text">
                                <h3 class="title cw">
                                    <span class="counter">1500</span><span
                                        >+</span
                                    >
                                </h3>
                                <p class="desc">Zufriedene Kunden</p>
                            </div>
                        </div>
                        <div
                            class="inner wow zoomIn"
                            data-wow-delay=".6s"
                            data-wow-duration="1s"
                        >
                            <div class="icon">
                                <img
                                    src="/images/counter/icon-03.svg"
                                    alt="Projekte Icon – über 5000 Fahrzeuge bearbeitet"
                                    width="80"
                                    height="80"
                                    loading="lazy"
                                />
                            </div>
                            <div class="text">
                                <h3 class="title cw">
                                    <span class="counter">5000</span><span
                                        >+</span
                                    >
                                </h3>
                                <p class="desc">Fahrzeuge bearbeitet</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <!-- Counter Area End -->

            <!-- Brand Area Start -->
            <section class="rts-brand-area pt--40 pb--20">
                <div class="container">
                    <div class="section-title-area2">
                        <p
                            class="sub-title wow fadeInUp"
                            data-wow-delay=".1s"
                            data-wow-duration="1s"
                        >
                            Automarken
                        </p>
                        <h2 class="section-title wow move-right">
                            Wir kaufen alle <span>Marken</span>
                        </h2>
                    </div>
                    <div class="section-inner mt--40">
                        <BrandSlider />
                    </div>
                </div>
            </section>
            <!-- Brand Area End -->

            <!-- Why Choose Us Area -->
            <section class="rts-why-choose-us rts-section-gap">
                <div class="right-image jarallax jara-mask-1">
                    <img
                        src="/images/about/why-choose-us.webp"
                        width="886"
                        height="886"
                        class="jarallax-img"
                        alt="Warum Prela Automobile – Auto verkaufen leicht gemacht"
                        loading="lazy"
                        decoding="async"
                    />
                </div>
                <div class="container">
                    <div class="section-inner">
                        <div class="row justify-content-end">
                            <div class="col-lg-6">
                                <div class="content-area">
                                    <div class="section-title-area">
                                        <p
                                            class="sub-title wow fadeInUp"
                                            data-wow-delay=".1s"
                                            data-wow-duration=".8s"
                                        >
                                            Warum Prela?
                                        </p>
                                        <h2
                                            class="section-title cw wow move-right"
                                        >
                                            Darum wählen Kunden <span>uns</span>
                                        </h2>
                                    </div>
                                    <ul class="why-choose-feature-list mt--60">
                                        <li
                                            class="wow fadeInUp"
                                            data-wow-delay=".1s"
                                            data-wow-duration="1s"
                                        >
                                            <div class="icon">
                                                <img
                                                    src="/images/why-choose/icon-01.svg"
                                                    alt="Autoankauf aller Marken Icon"
                                                    loading="lazy"
                                                />
                                            </div>
                                            <div class="content">
                                                <h6 class="title cw">
                                                    Wir kaufen Autos – jederzeit und in jedem Zustand!
                                                </h6>
                                                <p class="desc">
                                                    Sie möchten Ihr <a href="/bewertung" style="color: #fff; text-decoration: underline;">Auto verkaufen</a>
                                                    und den besten Preis erhalten? Bei uns bekommen Sie
                                                    die höchsten Marktpreise für Ihr Fahrzeug.
                                                </p>
                                            </div>
                                        </li>
                                        <li
                                            class="wow fadeInUp"
                                            data-wow-delay=".2s"
                                            data-wow-duration="1s"
                                        >
                                            <div class="icon">
                                                <img
                                                    src="/images/why-choose/icon-02.svg"
                                                    alt="Bestpreis Garantie Icon"
                                                    loading="lazy"
                                                />
                                            </div>
                                            <div class="content">
                                                <h6 class="title cw">
                                                    Bestpreis für Ihr Auto – sofort!
                                                </h6>
                                                <p class="desc">
                                                    Wir bieten die besten Preise auf dem Schweizer Markt.
                                                    Faire Bewertung, schnelle Zahlung – ohne versteckte Kosten.
                                                </p>
                                            </div>
                                        </li>
                                        <li
                                            class="wow fadeInUp"
                                            data-wow-delay=".3s"
                                            data-wow-duration="1s"
                                        >
                                            <div class="icon">
                                                <img
                                                    src="/images/why-choose/icon-03.svg"
                                                    alt="Papierkram erledigen Icon"
                                                    loading="lazy"
                                                />
                                            </div>
                                            <div class="content">
                                                <h6 class="title cw">
                                                    Stressfreier Autoverkauf
                                                </h6>
                                                <p class="desc">
                                                    Wir übernehmen den kompletten Papierkram: Abmeldung,
                                                    Ummeldung und alles, was dazugehört – ganz ohne Stress.
                                                </p>
                                            </div>
                                        </li>
                                        <li
                                            class="wow fadeInUp"
                                            data-wow-delay=".4s"
                                            data-wow-duration="1s"
                                        >
                                            <div class="icon">
                                                <img
                                                    src="/images/why-choose/icon-04.svg"
                                                    alt="Einfach Auto verkaufen Icon"
                                                    loading="lazy"
                                                />
                                            </div>
                                            <div class="content">
                                                <h6 class="title cw">
                                                    Auto verkaufen – einfach und schnell!
                                                </h6>
                                                <p class="desc">
                                                    Kein Inserieren, kein Warten auf Käufer. Einfach
                                                    <a href="/bewertung" style="color: #fff; text-decoration: underline;">Bewertung anfragen</a>,
                                                    Angebot erhalten und sofort verkaufen.
                                                </p>
                                            </div>
                                        </li>
                                        <li
                                            class="wow fadeInUp"
                                            data-wow-delay=".5s"
                                            data-wow-duration="1s"
                                        >
                                            <div class="icon">
                                                <img
                                                    src="/images/why-choose/icon-01.svg"
                                                    alt="Auto Import Export Icon"
                                                    loading="lazy"
                                                />
                                            </div>
                                            <div class="content">
                                                <h6 class="title cw">
                                                    Autoexport – weltweit!
                                                </h6>
                                                <p class="desc">
                                                    Sie möchten ein Auto importieren oder
                                                    <a href="/tipps/auto-exportieren" style="color: #fff; text-decoration: underline;">aus der Schweiz exportieren</a>?
                                                    Wir kümmern uns um Zoll, Logistik und Transport.
                                                </p>
                                            </div>
                                        </li>
                                        <li
                                            class="wow fadeInUp"
                                            data-wow-delay=".6s"
                                            data-wow-duration="1s"
                                        >
                                            <div class="icon">
                                                <img
                                                    src="/images/why-choose/icon-02.svg"
                                                    alt="Unfallwagen kaufen Icon"
                                                    loading="lazy"
                                                />
                                            </div>
                                            <div class="content">
                                                <h6 class="title cw">
                                                    Unfallwagen? Kein Problem!
                                                </h6>
                                                <p class="desc">
                                                    Unfälle passieren. Wenn Ihr Auto einen Schaden hat,
                                                    kaufen wir es trotzdem – schnell und fair.
                                                </p>
                                            </div>
                                        </li>
                                        <li
                                            class="wow fadeInUp"
                                            data-wow-delay=".7s"
                                            data-wow-duration="1s"
                                        >
                                            <div class="icon">
                                                <img
                                                    src="/images/why-choose/icon-03.svg"
                                                    alt="Traumauto kaufen Icon"
                                                    loading="lazy"
                                                />
                                            </div>
                                            <div class="content">
                                                <h6 class="title cw">
                                                    Ihr Traumauto finden!
                                                </h6>
                                                <p class="desc">
                                                    Wir verkaufen hochwertige Gebrauchtwagen
                                                    und bieten Probefahrten an. Finden Sie Ihr
                                                    <a href="/tipps/auto-kaufen" style="color: #fff; text-decoration: underline;">perfektes Fahrzeug</a>.
                                                </p>
                                            </div>
                                        </li>
                                        <li
                                            class="wow fadeInUp"
                                            data-wow-delay=".8s"
                                            data-wow-duration="1s"
                                        >
                                            <div class="icon">
                                                <img
                                                    src="/images/why-choose/icon-04.svg"
                                                    alt="Fahrzeugabholung Icon"
                                                    loading="lazy"
                                                />
                                            </div>
                                            <div class="content">
                                                <h6 class="title cw">
                                                    Wir kommen zu Ihnen!
                                                </h6>
                                                <p class="desc">
                                                    Kein Transportstress. Wir holen Ihr
                                                    Fahrzeug direkt bei Ihnen ab und machen
                                                    den Verkauf noch einfacher.
                                                </p>
                                            </div>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <!-- Why Choose Us Area End -->

            <!-- Testimonials Area Start -->
            <section class="rts-testimonials-area rts-section-gap">
                <div class="container">
                    <div class="section-title-area text-center">
                        <p
                            class="sub-title wow fadeInUp"
                            data-wow-delay=".1s"
                            data-wow-duration=".8s"
                        >
                            Kundenbewertungen (4.7 Google Reviews)
                        </p>
                        <h2 class="section-title wow move-right">
                            Das sagen unsere <span>Kunden</span>
                        </h2>
                    </div>
                    <div class="section-inner mt--80">
                        <div class="row align-items-center justify-content-end">
                            <div class="col-xl-12 col-lg-12">
                                <div class="slider-inner text-center">
                                    <div class="swiper testimonialSlider">
                                        <div class="swiper-wrapper">
                                            <div class="swiper-slide">
                                                <div
                                                    class="review-wrapper"
                                                    style="text-align: center; max-width: 800px; margin: 0 auto;"
                                                >
                                                    <ul
                                                        class="star-rating"
                                                        style="justify-content: center; font-size: 30px; margin-bottom: 20px;"
                                                    >
                                                        <li><i class="fa-solid fa-star"></i></li>
                                                        <li><i class="fa-solid fa-star"></i></li>
                                                        <li><i class="fa-solid fa-star"></i></li>
                                                        <li><i class="fa-solid fa-star"></i></li>
                                                        <li><i class="fa-solid fa-star-half-stroke"></i></li>
                                                    </ul>
                                                    <p
                                                        class="desc"
                                                        style="font-size: 20px; line-height: 1.6;"
                                                    >
                                                        "Wir hatten eine
                                                        hervorragende Erfahrung
                                                        mit der Prela Garage in
                                                        Sursee, insbesondere
                                                        dank der
                                                        Professionalität von
                                                        Herrn Valentin Prela.
                                                        Alles war transparent,
                                                        fair, effizient und über
                                                        den Erwartungen. Wir
                                                        empfehlen die Prela
                                                        Garage wärmstens
                                                        weiter!"
                                                    </p>
                                                    <div
                                                        class="author-area"
                                                        style="justify-content: center; margin-top: 30px;"
                                                    >
                                                        <h6
                                                            class="title"
                                                            style="margin-bottom: 0;"
                                                        >
                                                            Anca Muresan
                                                        </h6>
                                                        <p class="designation">
                                                            Local Google Guide
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="swiper-slide">
                                                <div
                                                    class="review-wrapper"
                                                    style="text-align: center; max-width: 800px; margin: 0 auto;"
                                                >
                                                    <ul
                                                        class="star-rating"
                                                        style="justify-content: center; font-size: 30px; margin-bottom: 20px;"
                                                    >
                                                        <li><i class="fa-solid fa-star"></i></li>
                                                        <li><i class="fa-solid fa-star"></i></li>
                                                        <li><i class="fa-solid fa-star"></i></li>
                                                        <li><i class="fa-solid fa-star"></i></li>
                                                        <li><i class="fa-solid fa-star"></i></li>
                                                    </ul>
                                                    <p
                                                        class="desc"
                                                        style="font-size: 20px; line-height: 1.6;"
                                                    >
                                                        "Ich bin zur Prela
                                                        Garage gewechselt und
                                                        kann mit gutem Gewissen
                                                        sagen: Mein Auto wurde
                                                        hier professionell
                                                        repariert. Das
                                                        Werkstatt-Team hat
                                                        ausgezeichnetes
                                                        Fachwissen, arbeitet
                                                        sehr präzise und ist
                                                        immer freundlich. Der
                                                        Alfa ist jetzt wieder in
                                                        Top-Zustand."
                                                    </p>
                                                    <div
                                                        class="author-area"
                                                        style="justify-content: center; margin-top: 30px;"
                                                    >
                                                        <h6
                                                            class="title"
                                                            style="margin-bottom: 0;"
                                                        >
                                                            Efstathios
                                                            Efstathiou
                                                        </h6>
                                                        <p class="designation">
                                                            Alfa Romeo Kunde
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="swiper-slide">
                                                <div
                                                    class="review-wrapper"
                                                    style="text-align: center; max-width: 800px; margin: 0 auto;"
                                                >
                                                    <ul
                                                        class="star-rating"
                                                        style="justify-content: center; font-size: 30px; margin-bottom: 20px;"
                                                    >
                                                        <li><i class="fa-solid fa-star"></i></li>
                                                        <li><i class="fa-solid fa-star"></i></li>
                                                        <li><i class="fa-solid fa-star"></i></li>
                                                        <li><i class="fa-solid fa-star"></i></li>
                                                        <li><i class="fa-solid fa-star"></i></li>
                                                    </ul>
                                                    <p
                                                        class="desc"
                                                        style="font-size: 20px; line-height: 1.6;"
                                                    >
                                                        "Une très bonne
                                                        expérience avec le
                                                        garage Prela. Je suis
                                                        tombé en panne sur
                                                        l'autoroute et ils m'ont
                                                        changé une pompe à eau
                                                        la matinée suivante.
                                                        Service rapide et prix
                                                        raisonnable. Je
                                                        recommande complètement
                                                        !"
                                                    </p>
                                                    <div
                                                        class="author-area"
                                                        style="justify-content: center; margin-top: 30px;"
                                                    >
                                                        <h6
                                                            class="title"
                                                            style="margin-bottom: 0;"
                                                        >
                                                            Clement Petit
                                                        </h6>
                                                        <p class="designation">
                                                            Local Guide
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="swiper-slide">
                                                <div
                                                    class="review-wrapper"
                                                    style="text-align: center; max-width: 800px; margin: 0 auto;"
                                                >
                                                    <ul
                                                        class="star-rating"
                                                        style="justify-content: center; font-size: 30px; margin-bottom: 20px;"
                                                    >
                                                        <li><i class="fa-solid fa-star"></i></li>
                                                        <li><i class="fa-solid fa-star"></i></li>
                                                        <li><i class="fa-solid fa-star"></i></li>
                                                        <li><i class="fa-solid fa-star"></i></li>
                                                        <li><i class="fa-solid fa-star"></i></li>
                                                    </ul>
                                                    <p
                                                        class="desc"
                                                        style="font-size: 20px; line-height: 1.6;"
                                                    >
                                                        "Ich bin absolut
                                                        begeistert von der Prela
                                                        Garage in Sursee! Die
                                                        Arbeit ist einfach top –
                                                        hohe Qualität zu einem
                                                        wirklich fairen und
                                                        günstigen Preis. Das
                                                        Personal ist super
                                                        zuvorkommend, freundlich
                                                        und kompetent."
                                                    </p>
                                                    <div
                                                        class="author-area"
                                                        style="justify-content: center; margin-top: 30px;"
                                                    >
                                                        <h6
                                                            class="title"
                                                            style="margin-bottom: 0;"
                                                        >
                                                            Rene Stoffel
                                                        </h6>
                                                        <p class="designation">
                                                            Zufriedener Kunde
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="swiper-pagination-4"></div>
                                </div>
                            </div>
                        </div>
