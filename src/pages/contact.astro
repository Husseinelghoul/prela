---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout title="Get In Touch">
    <div class="rts-wrapper">
        <div class="rts-wrapper-inner">
            <Header />

            <Breadcrumb 
                title="Get In Touch" 
                current="Contact" 
                className="service" 
            />

            <!-- Contact Start -->
            <section class="rts-contact-area inner rts-section-gap">
                <div class="container">
                    <div class="row align-items-start">
                        <div class="col-lg-5">
                            <div class="contact-map-area-fluid mb--50">
                                <iframe class="contact-map" height="400"
                                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2712.123456789!2d8.1065!3d47.1721!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x478ff0f8a8a8a8a8%3A0x123456789abcdef!2sAllmendstrasse%2010%2C%206210+Leutsern!5e0!3m2!1sen!2sch!4v1663151706353!5m2!1sen!2sch"
                                    style="border:0;" allowfullscreen="" loading="lazy"
                                    referrerpolicy="no-referrer-when-downgrade"></iframe>
                                    style="border:0;" allowfullscreen="" loading="lazy"
                                    referrerpolicy="no-referrer-when-downgrade"></iframe>
                            </div>
                            <div class="rts-contact-area2">
                                <div class="inner d-block">
                                    <div class="contact-wrapper mb--30">
                                        <div class="icon">
                                            <img src="/images/contact/01.svg" alt="">
                                        </div>
                                        <h5 class="title">Location</h5>
                                        <ul>
                                            <li><a href="https://www.google.com/maps/search/Allmendstrasse+10,+6210+Leutsern" target="_blank">Allmendstrasse 10, 6210 Leutsern</a></li>
                                        </ul>
                                    </div>
                                    <div class="contact-wrapper mb--30">
                                        <div class="icon">
                                            <img src="/images/contact/02.svg" alt="">
                                        </div>
                                        <h5 class="title">Email</h5>
                                        <ul>
                                            <li><a href="mailto:info@prela.ch">info@prela.ch</a></li>
                                        </ul>
                                    </div>
                                    <div class="contact-wrapper">
                                        <div class="icon">
                                            <img src="/images/contact/03.svg" alt="">
                                        </div>
                                        <h5 class="title">Phone</h5>
                                        <ul>
                                            <li><a href="callto:+41793088000">+41 79 3088 000</a></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-7">
                             <ContactForm />
                        </div>
                    </div>
                </div>
            </section>
            <!-- Contact End -->

            <!-- Counter Area Start -->
            <section class="rts-counter-area jarallax">
                <div class="container">
                    <div class="counter-inner">
                        <div class="inner wow zoomIn" data-wow-delay=".2s" data-wow-duration="1s">
                            <div class="icon">
                                <img src="/images/counter/icon-01.svg" width="74" alt="">
                            </div>
                            <div class="text">
                                <h3 class="title cw"><span class="counter">25</span><span>+</span></h3>
                                <p class="desc">Years of Experience</p>
                            </div>
                        </div>
                        <div class="inner wow zoomIn" data-wow-delay=".4s" data-wow-duration="1s">
                            <div class="icon">
                                <img src="/images/counter/icon-02.svg" alt="">
                            </div>
                            <div class="text">
                                <h3 class="title cw"><span class="counter">1500</span><span>+</span></h3>
                                <p class="desc">Satisfied Customers</p>
                            </div>
                        </div>
                        <div class="inner wow zoomIn" data-wow-delay=".6s" data-wow-duration="1s">
                            <div class="icon">
                                <img src="/images/counter/icon-03.svg" alt="">
                            </div>
                            <div class="text">
                                <h3 class="title cw"><span class="counter">5000</span><span>+</span></h3>
                                <p class="desc">Projects Completed</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <!-- Counter Area End -->

            <Footer />
        </div>
    </div>
</BaseLayout>
