---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const lastMonth = new Date();
lastMonth.setMonth(lastMonth.getMonth() - 1);
const formattedDate = lastMonth.toLocaleString("de-CH", {
    month: "long",
    year: "numeric",
});
---

<BaseLayout
    title="Datenschutzerklärung – Prela Automobile AG"
    description="Datenschutzerklärung von Prela Automobile AG. Erfahren Sie, wie wir Ihre Daten schützen und welche Rechte Sie haben."
>
    <div class="rts-wrapper">
        <div class="rts-wrapper-inner">
            <Header />

            <div class="legal-hero">
                <div class="container">
                    <div class="legal-hero-inner">
                        <div class="legal-icon"><i class="fa-light fa-shield-halved"></i></div>
                        <h1>Datenschutzerklärung</h1>
                        <p class="legal-subtitle">Ihre Daten sind bei uns sicher.</p>
                        <div class="legal-meta">
                            <span class="meta-item"><i class="fa-light fa-calendar"></i> Aktualisiert: {formattedDate}</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="legal-content-area rts-section-gap">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-10">
                            <div class="legal-content">
                                <div class="legal-section">
                                    <div class="section-number">01</div>
                                    <h2>Einleitung</h2>
                                    <p>Prela Automobile AG («wir», «unser» oder «uns») verpflichtet sich zum Schutz Ihrer Privatsphäre. Diese Datenschutzerklärung erläutert, wie wir Ihre Daten erheben, verwenden, weitergeben und schützen.</p>
                                    <div class="highlight-box"><i class="fa-light fa-shield-check"></i><p>Wir handeln in Übereinstimmung mit dem schweizerischen Datenschutzgesetz (DSG) und der DSGVO.</p></div>
                                </div>

                                <div class="legal-section">
                                    <div class="section-number">02</div>
                                    <h2>Welche Daten wir erheben</h2>
                                    <p>Wir erheben verschiedene Arten von Daten:</p>
                                    <div class="data-cards">
                                        <div class="data-card">
                                            <div class="data-card-icon"><i class="fa-light fa-user"></i></div>
                                            <h5>Personenbezogene Daten</h5>
                                            <p>Name, E-Mail, Telefonnummer und weitere Kontaktdaten bei Anfragen.</p>
                                        </div>
                                        <div class="data-card">
                                            <div class="data-card-icon"><i class="fa-light fa-car"></i></div>
                                            <h5>Fahrzeugdaten</h5>
                                            <p>Marke, Modell, Jahrgang, Kilometerstand und Zustand für präzise Bewertungen.</p>
                                        </div>
                                        <div class="data-card">
                                            <div class="data-card-icon"><i class="fa-light fa-chart-line"></i></div>
                                            <h5>Nutzungsdaten</h5>
                                            <p>IP-Adresse, Browser-Typ und besuchte Seiten – anonymisiert und aggregiert.</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="legal-section">
                                    <div class="section-number">03</div>
                                    <h2>Wie wir Ihre Daten verwenden</h2>
                                    <ul class="legal-list">
                                        <li>Erstellung von Fahrzeugbewertungen und Angeboten</li>
                                        <li>Beantwortung Ihrer Anfragen und Kundenbetreuung</li>
                                        <li>Verbesserung unserer Website und Dienstleistungen</li>
                                        <li>Versand von Marketingmitteilungen (nur mit Einwilligung)</li>
                                        <li>Erfüllung gesetzlicher Verpflichtungen</li>
                                    </ul>
                                </div>

                                <div class="legal-section">
                                    <div class="section-number">04</div>
                                    <h2>Datensicherheit</h2>
                                    <p>Wir setzen technische und organisatorische Massnahmen zum Schutz Ihrer Daten ein.</p>
                                    <div class="security-features">
                                        <div class="security-item"><i class="fa-light fa-lock"></i><span>SSL-Verschlüsselung</span></div>
                                        <div class="security-item"><i class="fa-light fa-server"></i><span>Sichere Server</span></div>
                                        <div class="security-item"><i class="fa-light fa-key"></i><span>Zugriffskontrolle</span></div>
                                        <div class="security-item"><i class="fa-light fa-rotate-right"></i><span>Regelmässige Backups</span></div>
                                    </div>
                                </div>

                                <div class="legal-section">
                                    <div class="section-number">05</div>
                                    <h2>Ihre Rechte</h2>
                                    <p>Gemäss schweizerischem Datenschutzrecht haben Sie folgende Rechte:</p>
                                    <div class="rights-grid">
                                        <div class="right-item"><i class="fa-light fa-eye"></i><div><strong>Auskunftsrecht</strong><p>Erfahren Sie, welche Daten wir gespeichert haben.</p></div></div>
                                        <div class="right-item"><i class="fa-light fa-pen"></i><div><strong>Berichtigungsrecht</strong><p>Lassen Sie fehlerhafte Daten korrigieren.</p></div></div>
                                        <div class="right-item"><i class="fa-light fa-trash-can"></i><div><strong>Löschungsrecht</strong><p>Verlangen Sie die Löschung Ihrer Daten.</p></div></div>
                                        <div class="right-item"><i class="fa-light fa-ban"></i><div><strong>Widerspruchsrecht</strong><p>Widersprechen Sie der Verarbeitung Ihrer Daten.</p></div></div>
                                        <div class="right-item"><i class="fa-light fa-download"></i><div><strong>Datenübertragbarkeit</strong><p>Erhalten Sie Ihre Daten in einem gängigen Format.</p></div></div>
                                    </div>
                                </div>

                                <div class="legal-section">
                                    <div class="section-number">06</div>
                                    <h2>Kontakt</h2>
                                    <p>Bei Fragen zum Datenschutz erreichen Sie uns unter:</p>
                                    <div class="contact-card">
                                        <strong>Prela Automobile AG</strong><br/>
                                        Allmendstrasse 10, 6210 Sursee, Schweiz<br/>
                                        E-Mail: <a href="mailto:info@prela-automobile.ch">info@prela-automobile.ch</a><br/>
                                        Telefon: <a href="tel:+41793088000">+41 79 308 80 00</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <Footer />
        </div>
    </div>
</BaseLayout>

<style>
    .legal-hero{background:linear-gradient(135deg,#0a1628 0%,#1a3a5c 50%,#0d2137 100%);padding:80px 0 60px;text-align:center;position:relative;overflow:hidden}
    .legal-hero::before{content:'';position:absolute;inset:0;background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");opacity:.5}
    .legal-hero-inner{position:relative;z-index:1}
    .legal-icon{width:80px;height:80px;background:rgba(255,255,255,.1);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.15);border-radius:20px;display:flex;align-items:center;justify-content:center;margin:0 auto 25px;font-size:36px;color:#4da6ff}
    .legal-hero h1{font-size:38px;font-weight:700;color:#fff;margin-bottom:15px}
    .legal-subtitle{font-size:18px;color:rgba(255,255,255,.7);max-width:500px;margin:0 auto 25px}
    .legal-meta{display:flex;justify-content:center;gap:30px;flex-wrap:wrap}
    .meta-item{font-size:14px;color:rgba(255,255,255,.5);display:flex;align-items:center;gap:8px}
    .legal-content{max-width:800px;margin:0 auto}
    .legal-section{margin-bottom:45px}
    .section-number{font-size:48px;font-weight:800;color:rgba(5,83,154,.06);line-height:1;margin-bottom:-10px}
    .legal-section h2{font-size:24px;font-weight:700;color:#1a1a1a;margin-bottom:15px;padding-bottom:12px;border-bottom:2px solid #f0f0f0}
    .legal-section p{font-size:16px;line-height:1.8;color:#555;margin-bottom:15px}
    .legal-list{list-style:none;padding:0;margin:15px 0}
    .legal-list li{position:relative;padding-left:28px;margin-bottom:10px;font-size:16px;line-height:1.7;color:#555}
    .legal-list li::before{content:'';position:absolute;left:0;top:10px;width:8px;height:8px;border-radius:50%;background:var(--color-primary)}
    .highlight-box{background:linear-gradient(135deg,#f0f7ff,#e8f0fe);border-left:4px solid var(--color-primary);border-radius:0 12px 12px 0;padding:20px 25px;display:flex;align-items:flex-start;gap:15px;margin:20px 0}
    .highlight-box i{font-size:24px;color:var(--color-primary);flex-shrink:0}
    .highlight-box p{margin:0;font-size:15px;color:#333}
    .data-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin:25px 0}
    .data-card{background:#fff;border:1px solid #eef2f7;border-radius:16px;padding:25px 20px;text-align:center;transition:transform .3s,box-shadow .3s}
    .data-card:hover{transform:translateY(-3px);box-shadow:0 10px 30px rgba(0,0,0,.08)}
    .data-card-icon{width:50px;height:50px;background:rgba(5,83,154,.08);border-radius:14px;display:flex;align-items:center;justify-content:center;margin:0 auto 15px;font-size:22px;color:var(--color-primary)}
    .data-card h5{font-size:16px;font-weight:700;color:#1a1a1a;margin-bottom:8px}
    .data-card p{font-size:14px;line-height:1.6;color:#777;margin:0}
    .security-features{display:grid;grid-template-columns:repeat(4,1fr);gap:15px;margin:25px 0}
    .security-item{background:#f8f9fa;border-radius:12px;padding:20px 15px;text-align:center;border:1px solid #e9ecef}
    .security-item i{font-size:28px;color:#25d366;display:block;margin-bottom:10px}
    .security-item span{font-size:13px;font-weight:600;color:#444}
    .rights-grid{display:flex;flex-direction:column;gap:15px;margin:20px 0}
    .right-item{display:flex;align-items:flex-start;gap:15px;background:#fff;border:1px solid #eef2f7;border-radius:12px;padding:20px;transition:border-color .3s}
    .right-item:hover{border-color:var(--color-primary)}
    .right-item>i{font-size:22px;color:var(--color-primary);background:rgba(5,83,154,.08);width:45px;height:45px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
    .right-item strong{display:block;font-size:16px;color:#1a1a1a;margin-bottom:4px}
    .right-item p{font-size:14px;color:#777;margin:0;line-height:1.5}
    .contact-card{background:#f8f9fa;border-radius:12px;padding:25px;border:1px solid #e9ecef;font-size:16px;line-height:1.8;color:#444}
    .contact-card a{color:var(--color-primary);text-decoration:none}
    .contact-card a:hover{text-decoration:underline}
    @media(max-width:768px){.legal-hero h1{font-size:28px}.data-cards{grid-template-columns:1fr}.security-features{grid-template-columns:repeat(2,1fr)}.legal-hero{padding:60px 0 40px}.section-number{font-size:36px}}
</style>
