---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Footer from "../../components/Footer.astro";
import ContactForm from "../../components/ContactForm.astro";
---

<BaseLayout title="Buying Your Dream Car - Tips">
    <div class="rts-wrapper">
        <div class="rts-wrapper-inner">
            <Header />

            <Breadcrumb
                title="Buying Your Dream Car"
                current="Buying Tips"
                className="service"
            />

            <section class="rts-service-area rts-section-gap">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-lg-6 order-lg-2">
                            <div class="about-image-area">
                                <img
                                    src="/images/blog/02.webp"
                                    alt="Buying a car"
                                    class="radius-10"
                                    loading="lazy"
                                    decoding="async"
                                />
                            </div>
                        </div>
                        <div class="col-lg-6 order-lg-1">
                            <div class="about-content-area">
                                <div class="section-title-area">
                                    <p class="sub-title">Expert Advice</p>
                                    <h2 class="section-title">
                                        What to look for when <span>buying</span
                                        > a car
                                    </h2>
                                </div>
                                <p class="desc">
                                    Purchasing a vehicle is a major investment.
                                    To protect yourself and your wallet, keep
                                    these key factors in mind:
                                </p>
                                <ul class="feature-list mt--20">
                                    <li>
                                        <i class="fa-regular fa-circle-check"
                                        ></i>
                                        <strong>Service History:</strong> Check if
                                        the car has been regularly maintained at authorized
                                        dealers.
                                    </li>
                                    <li>
                                        <i class="fa-regular fa-circle-check"
                                        ></i>
                                        <strong>Body Condition:</strong> Look for
                                        inconsistencies in paint or gaps in body panels
                                        which may indicate previous accidents.
                                    </li>
                                    <li>
                                        <i class="fa-regular fa-circle-check"
                                        ></i>
                                        <strong>Test Drive:</strong> Listen for unusual
                                        noises and check the responsiveness of brakes
                                        and transmission.
                                    </li>
                                    <li>
                                        <i class="fa-regular fa-circle-check"
                                        ></i>
                                        <strong>Warranty:</strong> Whenever possible,
                                        buy from dealers like us who offer a comprehensive
                                        warranty.
                                    </li>
                                </ul>
                                <div class="button-area mt--30">
                                    <a
                                        href="/contact"
                                        class="rts-btn btn-primary"
                                        >Browse Our Collection</a
                                    >
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- End of Page Form -->
            <section class="rts-contact-area rts-section-gap">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-8 offset-lg-2">
                            <ContactForm />
                        </div>
                    </div>
                </div>
            </section>

            <Footer />
        </div>
    </div>
</BaseLayout>
