---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Footer from "../../components/Footer.astro";
import ContactForm from "../../components/ContactForm.astro";
---

<BaseLayout title="Exporting Vehicles - Tips">
    <div class="rts-wrapper">
        <div class="rts-wrapper-inner">
            <Header />

            <Breadcrumb
                title="Exporting Vehicles"
                current="Exporting Tips"
                className="service"
            />

            <section class="rts-service-area rts-section-gap">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-lg-6">
                            <div class="about-image-area">
                                <img
                                    src="/images/blog/03.webp"
                                    alt="Exporting a car"
                                    class="radius-10"
                                    loading="lazy"
                                    decoding="async"
                                />
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="about-content-area">
                                <div class="section-title-area">
                                    <p class="sub-title">Expert Advice</p>
                                    <h2 class="section-title">
                                        What to look for when <span
                                            >exporting</span
                                        > a car
                                    </h2>
                                </div>
                                <p class="desc">
                                    Exporting a vehicle from Switzerland
                                    involves customs and logistics expertise.
                                    Here is how to navigate the process:
                                </p>
                                <ul class="feature-list mt--20">
                                    <li>
                                        <i class="fa-regular fa-circle-check"
                                        ></i>
                                        <strong>EUR.1 Document:</strong> This document
                                        is crucial for preferential customs treatment
                                        in many countries.
                                    </li>
                                    <li>
                                        <i class="fa-regular fa-circle-check"
                                        ></i>
                                        <strong>VAT Refund:</strong> If you are exporting
                                        a vehicle for commercial use, you may be eligible
                                        for a VAT refund.
                                    </li>
                                    <li>
                                        <i class="fa-regular fa-car"></i>
                                        <strong>Export Plates:</strong> You will need
                                        temporary export plates (Zollschilder) if
                                        you plan to drive the car out of the country.
                                    </li>
                                    <li>
                                        <i class="fa-regular fa-ship"></i>
                                        <strong>Logistics Partner:</strong> Choose
                                        a partner with experience in container or
                                        RoRo shipping.
                                    </li>
                                </ul>
                                <div class="button-area mt--30">
                                    <a
                                        href="/contact"
                                        class="rts-btn btn-primary radius-pill"
                                        >Inquire About Exporting</a
                                    >
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- End of Page Form -->
            <section class="rts-contact-area rts-section-gap">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-8 offset-lg-2">
                            <ContactForm />
                        </div>
                    </div>
                </div>
            </section>

            <Footer />
        </div>
    </div>
</BaseLayout>
