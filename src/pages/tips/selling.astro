---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Footer from "../../components/Footer.astro";
import ContactForm from "../../components/ContactForm.astro";
---

<BaseLayout title="Selling Your Car - Tips">
    <div class="rts-wrapper">
        <div class="rts-wrapper-inner">
            <Header />

            <Breadcrumb
                title="Selling Your Car"
                current="Selling Tips"
                className="service"
            />

            <section class="rts-service-area rts-section-gap">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-lg-6">
                            <div class="about-image-area">
                                <img
                                    src="/images/blog/01.webp"
                                    alt="Selling a car"
                                    class="radius-10"
                                    loading="lazy"
                                    decoding="async"
                                />
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="about-content-area">
                                <div class="section-title-area">
                                    <p class="sub-title">Expert Advice</p>
                                    <h2 class="section-title">
                                        What to look for when <span
                                            >selling</span
                                        > a car
                                    </h2>
                                </div>
                                <p class="desc">
                                    Selling your car in Switzerland requires
                                    careful preparation to ensure you get the
                                    best value and comply with legal
                                    requirements. Here are our top tips:
                                </p>
                                <ul class="feature-list mt--20">
                                    <li>
                                        <i class="fa-regular fa-circle-check"
                                        ></i>
                                        <strong>Complete Documentation:</strong>
                                        Ensure you have the service book (Serviceheft)
                                        and the vehicle registration document (Fahrzeugausweis).
                                    </li>
                                    <li>
                                        <i class="fa-regular fa-circle-check"
                                        ></i>
                                        <strong>Clean & Professional:</strong> A professional
                                        cleaning can increase the resale value significantly.
                                    </li>
                                    <li>
                                        <i class="fa-regular fa-circle-check"
                                        ></i>
                                        <strong>Recent MFK:</strong> A recent "Motorfahrzeugkontrolle"
                                        (MFK) makes your car much more attractive
                                        to private buyers.
                                    </li>
                                    <li>
                                        <i class="fa-regular fa-circle-check"
                                        ></i>
                                        <strong>Fair Pricing:</strong> Use market
                                        tools to set a competitive price based on
                                        mileage and condition.
                                    </li>
                                </ul>
                                <div class="button-area mt--30">
                                    <a
                                        href="/quote"
                                        class="rts-btn btn-primary radius-pill"
                                        >Get a Free Valuation</a
                                    >
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- End of Page Form -->
            <section class="rts-contact-area rts-section-gap">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-8 offset-lg-2">
                            <ContactForm />
                        </div>
                    </div>
                </div>
            </section>

            <Footer />
        </div>
    </div>
</BaseLayout>
